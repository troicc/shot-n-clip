{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qcard/v4/selection-audit.schema.json",
  "title": "selection_audit",
  "type": "object",
  "required": ["schema_version", "packs"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "3.0"},
    "video_id": {"type": "string"},
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pack_id", "status", "core_claim", "focus_question",
          "anchor_terms", "reader_value", "selected", "selection_review"
        ],
        "additionalProperties": true,
        "properties": {
          "pack_id": {"type": "string", "pattern": "^pack-[0-9]{2}$"},
          "status": {"enum": ["candidate", "ready", "rejected", "manual_review"]},
          "core_claim": {"type": "string", "minLength": 1},
          "focus_question": {"type": "string", "minLength": 1},
          "anchor_terms": {
            "type": "array", "minItems": 1, "maxItems": 3,
            "items": {"type": "string", "minLength": 1}, "uniqueItems": true
          },
          "reader_value": {"type": "string", "minLength": 1},
          "selected": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["candidate_id", "role", "support", "incremental_value"],
              "additionalProperties": true,
              "properties": {
                "candidate_id": {"type": "string"},
                "role": {"enum": ["hook", "problem", "mechanism", "evidence", "method", "close"]},
                "support": {"enum": ["direct", "essential", "adjacent", "weak"]},
                "incremental_value": {"type": "string", "minLength": 1}
              }
            }
          },
          "selection_review": {
            "type": "object",
            "required": ["verdict", "issues"],
            "additionalProperties": true,
            "properties": {
              "verdict": {"enum": ["pass", "revise", "manual_review"]},
              "issues": {"type": "array", "items": {"type": "string"}},
              "weakest_candidate_id": {"type": ["string", "null"]},
              "drop_test": {"type": "string"},
              "competitor_test": {"type": "string"},
              "why_this_order": {"type": "string"}
            }
          },
          "rejection_reason": {"type": ["string", "null"]}
        }
      }
    }
  }
}
