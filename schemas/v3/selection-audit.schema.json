{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qcard/v3/selection-audit.schema.json",
  "title": "selection_audit",
  "type": "object",
  "required": ["schema_version", "packs"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "3.0"},
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pack_id", "status", "core_claim", "selected", "selection_review"],
        "properties": {
          "pack_id": {"type": "string", "pattern": "^pack-[0-9]{2}$"},
          "status": {"enum": ["candidate", "ready", "rejected", "manual_review"]},
          "core_claim": {"type": "string", "minLength": 1},
          "selected": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["candidate_id", "role", "support", "incremental_value"],
              "properties": {
                "candidate_id": {"type": "string"},
                "role": {"enum": ["hook", "problem", "mechanism", "evidence", "method", "close"]},
                "support": {"enum": ["direct", "essential", "weak", "indirect"]},
                "incremental_value": {"type": "string", "minLength": 1}
              }
            }
          },
          "selection_review": {
            "type": "object",
            "required": ["verdict", "issues"],
            "properties": {
              "verdict": {"enum": ["pass", "revise", "manual_review"]},
              "issues": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
