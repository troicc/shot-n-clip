{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qcard/v3/translation-audit.schema.json",
  "title": "translation_audit",
  "type": "object",
  "required": ["schema_version", "pack_id", "quotes"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "3.0"},
    "pack_id": {"type": "string"},
    "quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["quote_id", "candidate_id", "source_claim_units", "back_translation_en", "fidelity_ledger", "naturalness_checks", "review_verdict", "issues"],
        "properties": {
          "quote_id": {"type": "string"},
          "candidate_id": {"type": "string"},
          "source_claim_units": {"type": "array", "minItems": 1},
          "back_translation_en": {"type": "string", "minLength": 1},
          "fidelity_ledger": {
            "type": "object",
            "required": ["additions", "omissions", "strengthenings", "weakenings"]
          },
          "naturalness_checks": {
            "type": "object",
            "required": ["native_without_source", "read_aloud", "collocation", "no_translationese", "no_slogan_clipping"]
          },
          "review_verdict": {"enum": ["pass", "revise", "manual_review"]},
          "issues": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
