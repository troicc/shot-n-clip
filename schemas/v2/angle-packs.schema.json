{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qcard/v2/angle-packs.schema.json",
  "title": "angle_packs",
  "type": "object",
  "required": ["schema_version", "video_id", "packs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "2.0"},
    "video_id": {"type": "string"},
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pack_id", "slug", "title_zh_internal", "core_claim", "reader_value", "quote_roles", "supporting_source_spans", "coherence_score", "novelty_score", "evidence_density_score", "platform_fit_score", "overlap_with_other_packs", "status", "rejection_reason"],
        "additionalProperties": false,
        "properties": {
          "pack_id": {"type": "string", "pattern": "^pack-[0-9]{2}$"},
          "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "title_zh_internal": {"type": "string", "minLength": 4},
          "core_claim": {"type": "string", "minLength": 8},
          "reader_value": {"type": "string", "minLength": 8},
          "quote_roles": {
            "type": "array", "minItems": 4,
            "items": {"enum": ["hook", "problem", "mechanism", "evidence", "method", "close"]}
          },
          "supporting_source_spans": {
            "type": "array", "minItems": 4,
            "items": {
              "type": "object",
              "required": ["segment_id", "start_sec", "end_sec"],
              "properties": {
                "segment_id": {"type": "string"},
                "start_sec": {"type": "number"},
                "end_sec": {"type": "number"},
                "note": {"type": "string"}
              }
            }
          },
          "coherence_score": {"type": "integer", "minimum": 0, "maximum": 10},
          "novelty_score": {"type": "integer", "minimum": 0, "maximum": 10},
          "evidence_density_score": {"type": "integer", "minimum": 0, "maximum": 10},
          "platform_fit_score": {"type": "integer", "minimum": 0, "maximum": 10},
          "overlap_with_other_packs": {"type": "object"},
          "status": {"enum": ["candidate", "ready", "rejected", "manual_review"]},
          "rejection_reason": {"type": ["string", "null"]}
        }
      }
    }
  }
}
