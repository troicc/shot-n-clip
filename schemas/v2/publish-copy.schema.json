{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qcard/v2/publish-copy.schema.json",
  "title": "publish_copy",
  "type": "object",
  "required": ["schema_version", "platform", "pack_id", "content_brief", "title_candidates", "recommended_title", "intro_full", "hashtags", "source_note", "review"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "2.0"},
    "platform": {"enum": ["xhs", "wechat"]},
    "pack_id": {"type": "string"},
    "content_brief": {
      "type": "object",
      "required": ["core_claim", "reader_value", "key_facts", "misread_risk", "tone"],
      "properties": {
        "core_claim": {"type": "string"},
        "reader_value": {"type": "string"},
        "key_facts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "misread_risk": {"type": "string"},
        "tone": {"type": "string"},
        "banned_angles": {"type": "array", "items": {"type": "string"}}
      }
    },
    "title_candidates": {
      "type": "array", "minItems": 4,
      "items": {
        "type": "object",
        "required": ["text", "strategy", "score", "risk"],
        "properties": {
          "text": {"type": "string", "minLength": 4},
          "strategy": {"enum": ["direct", "question", "contrast", "story", "number"]},
          "score": {"type": "number", "minimum": 0, "maximum": 10},
          "risk": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "recommended_title": {"type": "string", "minLength": 4},
    "intro_short": {"type": "string"},
    "intro_full": {"type": "string", "minLength": 40},
    "quote_contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["quote_id", "context"],
        "properties": {
          "quote_id": {"type": "string"},
          "context": {"type": "string"}
        }
      }
    },
    "hashtags": {"type": "array", "minItems": 3, "maxItems": 6, "items": {"type": "string"}},
    "source_note": {"type": "string", "minLength": 8},
    "review": {
      "type": "object",
      "required": ["naturalness_score", "specificity_score", "ai_tone_risk", "unsupported_claims"],
      "properties": {
        "naturalness_score": {"type": "number", "minimum": 0, "maximum": 10},
        "specificity_score": {"type": "number", "minimum": 0, "maximum": 10},
        "ai_tone_risk": {"type": "number", "minimum": 0, "maximum": 10},
        "unsupported_claims": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
