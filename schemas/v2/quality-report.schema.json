{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qcard/v2/quality-report.schema.json",
  "title": "quality_report",
  "type": "object",
  "required": ["schema_version", "pack_id", "scores", "manual_review_items", "status"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "2.0"},
    "pack_id": {"type": "string"},
    "scores": {
      "type": "object",
      "required": ["source_integrity", "entity_integrity", "translation_fidelity", "chinese_naturalness", "anti_template_quality", "pack_coherence", "platform_copy_quality", "layout_readability"],
      "additionalProperties": false,
      "properties": {
        "source_integrity": {"type": "number", "minimum": 0, "maximum": 100},
        "entity_integrity": {"type": "number", "minimum": 0, "maximum": 100},
        "translation_fidelity": {"type": "number", "minimum": 0, "maximum": 100},
        "chinese_naturalness": {"type": "number", "minimum": 0, "maximum": 100},
        "anti_template_quality": {"type": "number", "minimum": 0, "maximum": 100},
        "pack_coherence": {"type": "number", "minimum": 0, "maximum": 100},
        "platform_copy_quality": {"type": "number", "minimum": 0, "maximum": 100},
        "layout_readability": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "manual_review_items": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["ready", "manual_review", "rejected"]},
    "generated_at": {"type": "string"},
    "notes": {"type": "string"}
  }
}
